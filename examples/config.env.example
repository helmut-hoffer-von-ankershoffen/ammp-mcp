# `~/.ammp/config.env` — example.
#
# Loaded by pydantic-settings on import; any unset key falls back to
# its built-in default. Comments and blank lines are ignored; the file
# must be ASCII (python-dotenv crashes on non-ASCII under ASCII
# locales).
#
# `ammp serve` auto-generates this file on first run with the minimum
# needed. `ammp setup` regenerates it interactively with backend
# choices filled in.

# ─── Runtime directory ─────────────────────────────────────────────
# Single tree holding mentors/, mentees.json, audit.log, config.env.
AMMP_DIR=/Users/<you>/.ammp

# ─── Network ───────────────────────────────────────────────────────
# `http` (Streamable-HTTP on /mcp/) or `stdio` (subprocess transport).
AMMP_TRANSPORT=http
AMMP_HOST=127.0.0.1
AMMP_PORT=8765
# Public URL advertised in capability JSON. Set to your own domain.
AMMP_PUBLIC_URL=http://127.0.0.1:8765

# ─── Mentor registry ───────────────────────────────────────────────
# Default: <AMMP_DIR>/mentors. Override to point at a curated location
# (e.g. an Obsidian vault) — when set, bootstrap will NOT seed the
# packaged example mentor into it.
AMMP_MENTORS_ROOT=
AMMP_DEFAULT_MENTOR=example

# ─── Mentee allowlist ──────────────────────────────────────────────
# Default: <AMMP_DIR>/mentees.json. SHA-256-hashed Bearer keys only.
AMMP_MENTEES_FILE=
# Off for localhost dev; flip on for any non-loopback deployment.
AMMP_REQUIRE_AUTH=false

# ─── AskMentor backend ─────────────────────────────────────────────
# Needed when any mentor sets `backend.kind = anthropic`. Without it,
# AskMentor falls back to a deterministic stub (confidence 0.2, which
# always triggers an escalation recommendation).
AMMP_ANTHROPIC_API_KEY=
AMMP_LLM_MODEL=claude-opus-4-7
AMMP_LLM_MAX_CONCURRENT=10
AMMP_LLM_TIMEOUT_SECONDS=30.0
# Below this self-reported confidence, AskMentor adds a mentor-
# triggered EscalateToHuman recommendation to the response.
AMMP_LLM_CONFIDENCE_THRESHOLD=0.6

# ─── Audit log ─────────────────────────────────────────────────────
# Default: <AMMP_DIR>/audit.log. Hash-only (AMMP §6.2).
AMMP_AUDIT_LOG_PATH=
